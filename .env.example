# CareNest Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=carenest_super_secret_session_key_change_in_production_2026
JWT_SECRET_KEY=carenest_jwt_secret_signing_key_secure_vault_9921

# Database Configuration
# Local development uses SQLite (the database file is created automatically).
DATABASE_URL=sqlite:///carenest.sqlite3
# To use PostgreSQL instead, replace the line above with a URL for a real
# PostgreSQL role and database, for example:
# DATABASE_URL=postgresql://YOUR_ROLE:YOUR_PASSWORD@localhost:5432/carenest_db

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880  # 5 MB in bytes
